# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

# --- Public site ---
# Full public URL of the portfolio (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Where contact-form enquiries are delivered (defaults to ordinarylancer@gmail.com).
CONTACT_TO_EMAIL=ordinarylancer@gmail.com

# --- Owner login (private workspace) ---
# Generate all three with:  npm run hash-password -- "your-strong-password"
OWNER_LOGIN_ID=ordinarylancer@gmail.com
OWNER_PASSWORD_HASH_B64=
# Signs the session cookie. Random, 32+ chars. Changing it logs out every session.
AUTH_SECRET=
# Shared secret the job-application worker sends to /api/send-job-emails.
WORKER_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# No longer used by the app (all data goes through the authenticated /api/db bridge).
# Kept only for backwards compatibility; safe to leave empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server/worker only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Places API (Prospect Finder) ---
GOOGLE_PLACES_API_KEY=

# --- Shared outreach email SMTP gateway ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SENDER_NAME="ordinary CRM"
SENDER_EMAIL=

# Frontend public fallback variables (mirror of the SMTP block above)
NEXT_PUBLIC_SMTP_HOST=smtp.gmail.com
NEXT_PUBLIC_SMTP_PORT=587
NEXT_PUBLIC_SMTP_USER=
NEXT_PUBLIC_SMTP_SECURE=false
NEXT_PUBLIC_SENDER_NAME="ordinary CRM"
NEXT_PUBLIC_SENDER_EMAIL=

# --- LocationIQ API Key ---
LOCATIONIQ_API_KEY=
EXPO_PUBLIC_LOCATIONIQ_API_KEY=
NEXT_PUBLIC_LOCATIONIQ_API_KEY=

# --- Job Application Emails ---
# Sender identity used on outgoing application emails (falls back to yogesharma914@gmail.com if unset)
JOB_APPLICATION_SENDER_EMAIL=
JOB_APPLICATION_SENDER_NAME=
# Dedicated SMTP credentials for the sender above — a separate Gmail App Password for the
# sender address itself (not a Send-As alias). Generate at
# https://myaccount.google.com/apppasswords. Falls back to the shared SMTP_* values above if left blank.
JOB_APPLICATION_SMTP_HOST=smtp.gmail.com
JOB_APPLICATION_SMTP_PORT=587
JOB_APPLICATION_SMTP_USER=
JOB_APPLICATION_SMTP_PASS=
JOB_APPLICATION_SMTP_SECURE=false
# Links inserted into the compiled email template's CTA buttons/footer
JOB_APPLICATION_PORTFOLIO_URL=
JOB_APPLICATION_GITHUB_URL=
JOB_APPLICATION_LINKEDIN_URL=
JOB_APPLICATION_RESUME_URL=
# Base URL the job-application-worker.js script calls to trigger batches
JOB_APPLICATION_APP_BASE_URL=http://localhost:3000
